# Apache / Hostinger Web Access Denial Rule (Apply Note A-1, OWASP A02/A05)
# Deny direct HTTP access to .env files and config directory

<FilesMatch "^\.env">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_authz_core.c>
    <FilesMatch "^\.env">
        Require all denied
    </FilesMatch>
</IfModule>
