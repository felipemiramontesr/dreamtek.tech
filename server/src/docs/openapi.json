{
  "openapi": "3.1.0",
  "info": {
    "title": "Dreamtek.tech API",
    "version": "1.0.0",
    "description": "API Enterprise de Dreamtek.tech documentada bajo el estándar OpenAPI 3.1.0 (FC 001i ISO 25010)."
  },
  "servers": [
    {
      "url": "https://apiv1.dreamtek.tech/api/v1",
      "description": "Production Server"
    },
    {
      "url": "http://localhost:3001/api/v1",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Iniciar Sesión",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "cliente@empresa.com"
                  },
                  "password": { "type": "string", "minLength": 8, "example": "Password123!" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Autenticación exitosa. Retorna galleta HttpOnly." },
          "400": { "description": "Error de validación de esquema Zod." },
          "401": { "description": "Credenciales inválidas." },
          "429": { "description": "Límite de intentos superado (Rate Limit 5/15m)." }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Crear Cuenta de Cliente",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["full_name", "email", "password"],
                "properties": {
                  "full_name": { "type": "string", "minLength": 2, "example": "Juan Pérez" },
                  "email": { "type": "string", "format": "email", "example": "juan@empresa.com" },
                  "password": { "type": "string", "minLength": 8, "example": "Password123!" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Usuario registrado exitosamente." },
          "400": { "description": "Error de validación o usuario existente." }
        }
      }
    },
    "/contact": {
      "post": {
        "summary": "Envío de Formulario de Contacto",
        "tags": ["Contact"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "subject", "message"],
                "properties": {
                  "name": { "type": "string", "minLength": 2 },
                  "email": { "type": "string", "format": "email" },
                  "subject": { "type": "string", "maxLength": 200 },
                  "message": { "type": "string", "maxLength": 2000 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Mensaje enviado exitosamente." },
          "400": { "description": "Error de validación Zod." }
        }
      }
    },
    "/contact/send-code": {
      "post": {
        "summary": "Generación y Envío de Código 2FA",
        "tags": ["Contact"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "name": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Código de verificación enviado." }
        }
      }
    },
    "/onboarding/lead": {
      "post": {
        "summary": "Ingesta de Prospecto Onboarding",
        "tags": ["Onboarding"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "phone": { "type": "string" },
                  "company": { "type": "string" },
                  "planId": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Lead registrado." }
        }
      }
    },
    "/onboarding/domain": {
      "post": {
        "summary": "Verificación FQDN de Dominio",
        "tags": ["Onboarding"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["domain"],
                "properties": {
                  "domain": { "type": "string", "example": "miempresa.com" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Estado de disponibilidad del dominio." }
        }
      }
    },
    "/acl/entries": {
      "get": {
        "summary": "Consultar entradas de ACL de un recurso",
        "tags": ["Access Control"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          {
            "name": "resource_type",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["WORKSPACE", "COLLECTION", "ASSET"] }
          },
          {
            "name": "resource_id",
            "in": "query",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Lista de entradas de ACL del recurso." },
          "403": { "description": "Acceso denegado por política de ACL." }
        }
      },
      "post": {
        "summary": "Otorgar o actualizar permiso granular en ACL",
        "tags": ["Access Control"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "resource_type",
                  "resource_id",
                  "principal_type",
                  "principal_id",
                  "permission"
                ],
                "properties": {
                  "resource_type": {
                    "type": "string",
                    "enum": ["WORKSPACE", "COLLECTION", "ASSET"]
                  },
                  "resource_id": { "type": "integer" },
                  "principal_type": { "type": "string", "enum": ["USER", "ROLE"] },
                  "principal_id": { "type": "string" },
                  "permission": {
                    "type": "string",
                    "enum": ["VIEW", "DOWNLOAD", "EDIT", "MANAGE", "DELETE"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Permiso de ACL registrado exitosamente." },
          "403": { "description": "Se requiere permiso MANAGE para otorgar permisos." }
        }
      }
    },
    "/acl/entries/{id}": {
      "delete": {
        "summary": "Revocar entrada de ACL",
        "tags": ["Access Control"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Entrada de ACL revocada exitosamente." },
          "403": { "description": "Se requiere permiso MANAGE." },
          "404": { "description": "Entrada de ACL no encontrada." }
        }
      }
    },
    "/acl/check": {
      "get": {
        "summary": "Evaluar permiso efectivo de un actor sobre un recurso",
        "tags": ["Access Control"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          {
            "name": "resource_type",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["WORKSPACE", "COLLECTION", "ASSET"] }
          },
          {
            "name": "resource_id",
            "in": "query",
            "required": true,
            "schema": { "type": "integer" }
          },
          {
            "name": "permission",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["VIEW", "DOWNLOAD", "EDIT", "MANAGE", "DELETE"] }
          }
        ],
        "responses": {
          "200": { "description": "Resultado de la evaluación jerárquica de permisos." }
        }
      }
    },
    "/workspaces": {
      "get": {
        "summary": "Listar espacios de trabajo del tenant",
        "tags": ["Workspaces"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de espacios de trabajo con estadísticas de colecciones y activos."
          }
        }
      },
      "post": {
        "summary": "Crear un nuevo espacio de trabajo en el tenant",
        "tags": ["Workspaces"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "maxLength": 100 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Espacio de trabajo creado exitosamente." },
          "403": { "description": "Se requiere rol ADMIN o ser propietario del tenant." }
        }
      }
    },
    "/workspaces/{id}": {
      "get": {
        "summary": "Obtener detalle y estadísticas de un espacio de trabajo",
        "tags": ["Workspaces"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Detalle del espacio de trabajo." },
          "403": { "description": "Acceso denegado por ACL." },
          "404": { "description": "Espacio de trabajo no encontrado." }
        }
      },
      "put": {
        "summary": "Actualizar nombre de un espacio de trabajo",
        "tags": ["Workspaces"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "maxLength": 100 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Espacio de trabajo actualizado exitosamente." },
          "403": { "description": "Acceso denegado por ACL." },
          "404": { "description": "Espacio de trabajo no encontrado." }
        }
      },
      "delete": {
        "summary": "Eliminar espacio de trabajo vacío",
        "tags": ["Workspaces"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Espacio de trabajo eliminado exitosamente." },
          "403": { "description": "Acceso denegado por ACL." },
          "404": { "description": "Espacio de trabajo no encontrado." },
          "409": { "description": "El espacio de trabajo contiene colecciones o activos activos." }
        }
      }
    },
    "/collections": {
      "get": {
        "summary": "Listar colecciones del tenant",
        "tags": ["Collections"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Lista de colecciones con estadísticas de activos." }
        }
      },
      "post": {
        "summary": "Crear una nueva colección en un espacio de trabajo",
        "tags": ["Collections"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["workspace_id", "name"],
                "properties": {
                  "workspace_id": { "type": "integer" },
                  "name": { "type": "string", "maxLength": 100 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Colección creada exitosamente." },
          "403": { "description": "Acceso denegado por ACL en el workspace." },
          "404": { "description": "Espacio de trabajo no encontrado." }
        }
      }
    },
    "/collections/{id}": {
      "get": {
        "summary": "Obtener detalle y estadísticas de una colección",
        "tags": ["Collections"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Detalle de la colección." },
          "403": { "description": "Acceso denegado por ACL." },
          "404": { "description": "Colección no encontrada." }
        }
      },
      "put": {
        "summary": "Actualizar nombre de una colección",
        "tags": ["Collections"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "maxLength": 100 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Colección actualizada exitosamente." },
          "403": { "description": "Acceso denegado por ACL." },
          "404": { "description": "Colección no encontrada." }
        }
      },
      "delete": {
        "summary": "Eliminar colección vacía",
        "tags": ["Collections"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Colección eliminada exitosamente." },
          "403": { "description": "Acceso denegado por ACL." },
          "404": { "description": "Colección no encontrada." },
          "409": { "description": "La colección contiene activos activos." }
        }
      }
    },
    "/assets/{id}/location": {
      "patch": {
        "summary": "Reubicar activo digital en otra colección y/o espacio de trabajo",
        "tags": ["Assets"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["workspace_id"],
                "properties": {
                  "workspace_id": { "type": "integer" },
                  "collection_id": { "type": ["integer", "null"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Activo reubicado exitosamente." },
          "400": { "description": "Espacio de trabajo o colección de destino inválidos." },
          "403": { "description": "Acceso denegado por ACL en origen o destino." },
          "404": { "description": "Activo no encontrado." }
        }
      }
    },
    "/assets/{id}/versions": {
      "post": {
        "summary": "Subir una nueva versión de un activo digital existente",
        "tags": ["Asset Versions"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Nueva versión creada exitosamente." },
          "400": { "description": "Archivo faltante o Magic Bytes no permitidos." },
          "403": { "description": "Acceso denegado por ACL (requiere EDIT)." },
          "404": { "description": "Activo digital no encontrado." }
        }
      },
      "get": {
        "summary": "Listar historial de versiones de un activo digital",
        "tags": ["Asset Versions"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Historial de versiones recuperado exitosamente." },
          "403": { "description": "Acceso denegado por ACL (requiere VIEW)." },
          "404": { "description": "Activo digital no encontrado." }
        }
      }
    },
    "/assets/{id}/versions/{versionNumber}/stream": {
      "get": {
        "summary": "Descargar o reproducir streaming de una versión histórica específica",
        "tags": ["Asset Versions"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          {
            "name": "versionNumber",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Streaming binario de la versión." },
          "403": { "description": "Acceso denegado por ACL (requiere DOWNLOAD)." },
          "404": { "description": "Activo o versión no encontrada." }
        }
      }
    },
    "/assets/{id}/versions/{versionNumber}/thumbnail": {
      "get": {
        "summary": "Obtener miniatura WebP de una versión histórica específica",
        "tags": ["Asset Versions"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          {
            "name": "versionNumber",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Miniatura WebP servida exitosamente." },
          "403": { "description": "Acceso denegado por ACL (requiere VIEW)." },
          "404": { "description": "Miniatura o versión no disponible." }
        }
      }
    },
    "/assets/{id}/versions/{versionNumber}/promote": {
      "post": {
        "summary": "Promover una versión histórica como nueva versión cabecera activa (HEAD)",
        "tags": ["Asset Versions"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          {
            "name": "versionNumber",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Versión promovida exitosamente." },
          "403": { "description": "Acceso denegado por ACL (requiere EDIT)." },
          "404": { "description": "Activo o versión a promover no encontrada." }
        }
      }
    }
  }
}
